#!/usr/bin/env python3
"""
HERMES Control Centre - Unified management console.
Run: python3 hermes_ctl [COMMAND] [ARGS]

Commands:
  status      - Show all module states
  money       - Run all income generators
  spark       - Spark Navigator controls
  backup      - Force backup now
  logs        - Tail recent activity
  earnings    - Show cumulative totals
"""

import sys, json, subprocess, os
from pathlib import Path
from datetime import datetime

BASE = Path.home()/"HERMES"

def cmd_status():
    checks = {
        "Database": BASE/"spark_infra/db/spark.db",
        "Grants Bot": BASE/"active_income/grant_bot/cache.json",
        "Surveys": BASE/"active_income/survey_agg/opps.json",
        "Crypto Arb": BASE/"active_income/crypto_watch/spreads.json",
        "Affiliates": BASE/"active_income/affiliate_grid/pages/tools.html",
        "Web Demo": BASE/"spark_web_demo/index.html",
    }
    
    print("\n" + "="*50)
    print("HERMES SYSTEM STATUS")
    print("="*50)
    
    for name, path in checks.items():
        status = "READY" if path.exists() else "MISSING"
        sym = "+" if status == "READY" else "-"
        print(f"  [{sym}] {name}: {status}")
    
    # Running processes
    print("\nACTIVE PROCESSES:")
    procs = subprocess.run(["pgrep", "-fa", "HERMES"], capture_output=True, text=True)
    for line in procs.stdout.strip().split("\n")[:5]:
        if line:
            pid, cmd = line.split(maxsplit=1)
            print(f"  [{pid}] {cmd[:50]}")
    
    print("="*50 + "\n")

def cmd_money():
    print("\n[RUNNING] All income modules...\n")
    
    mods = [
        "active_income/grant_bot/scanner.py",
        "active_income/survey_agg/aggregator.py", 
        "active_income/crypto_watch/arbitrage.py",
    ]
    
    for mod in mods:
        path = BASE/mod
        if path.exists():
            print(f"--> {mod}")
            subprocess.run(["python3", str(path)])
        else:
            print(f"--X {mod} NOT FOUND")
    
    print("\n[DONE] Money sweep complete.")

def cmd_earnings():
    db = BASE/"spark_infra/db/spark.db"
    if not db.exists():
        print("[ERR] Database not initialized. Run: hermes_ctl spark init")
        return
    
    import sqlite3
    conn = sqlite3.connect(db)
    total = conn.execute("SELECT COALESCE(SUM(amount),0) FROM earnings_log").fetchone()[0]
    count = conn.execute("SELECT COUNT(*) FROM earnings_log").fetchone()[0]
    conn.close()
    
    print(f"\n[EARNINGS] Total: ${total:.2f} from {count} entries\n")

def cmd_backup():
    dbmgr = BASE/"spark_infra/db_manager.py"
    if dbmgr.exists():
        subprocess.run(["python3", str(dbmgr)])
    print("[BACKUP] Forced backup complete.")

def cmd_logs(lines=20):
    logfiles = [
        BASE/"spark_infra/logs/heartbeat.log",
        BASE/"logs/healer.out",
        BASE*"logs/api.out",
    ]
    
    for lf in logfiles:
        if lf.exists():
            print(f"\n-- {lf.name} (--tail)--")
            os.system(f"tail -{lines} {lf}")

CMDS = {
    "status": cmd_status,
    "money": cmd_money,
    "earnings": cmd_earnings,
    "backup": cmd_backup,
    "logs": cmd_logs,
}

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(0)
    
    cmd = sys.argv[1].lower()
    if cmd in CMDS:
        CMDS[cmd]()
    else:
        print(f"Unknown command: {cmd}")
        print("Valid commands:", ", ".join(CMDS.keys()))
